# Copy to `.env` (which is gitignored) and fill in locally. NEVER commit real values.

# Anthropic — used ONLY by the managed/broker path or a gated live smoke test.
# In CI this is a GitHub Actions secret, not this file. Not needed for the test-double path.
ANTHROPIC_API_KEY=

# DEV Community (dev.to) API key for the devto MCP server (blog drafts).
# On Kiro Web this is provided via the secret syntax in .kiro/settings/mcp.json, not here.
DEVTO_API_KEY=
