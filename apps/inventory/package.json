{
  "name": "@taylor-made-labs/user-tailored-inventory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Inventory app that adopts the user-tailored-ui foundation through its public ports: track stock items (quantity/location/low-stock threshold) and customize the catalog into a low-stock focus view via an in-app agent.",
  "license": "MIT OR Apache-2.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --ext .ts,.tsx --max-warnings 0"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "20.14.9",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@typescript-eslint/eslint-plugin": "7.16.0",
    "@typescript-eslint/parser": "7.16.0",
    "@vitejs/plugin-react": "4.3.1",
    "eslint": "8.57.0",
    "eslint-plugin-react-hooks": "4.6.2",
    "eslint-plugin-react-refresh": "0.4.7",
    "typescript": "5.5.3",
    "vite": "5.3.3",
    "vitest": "1.6.0"
  }
}
